INSERT INTO `tours` VALUES (1,'Сонячна Туреччина All Inclusive','Незабутній відпочинок на узбережжі Середземного моря з повним пансіоном. Готель 5*, аквапарк, анімація.',28500.00,10,'2025-05-01 00:00:00.000000','2025-09-30 00:00:00.000000',1,'0001-01-01 00:00:00.000000',0),(2,'Карпатська казка','Пішохідні маршрути Карпатами, ночівля у затишних колибах, дегустація гуцульської кухні.',4200.00,7,'2025-06-01 00:00:00.000000','2025-10-15 00:00:00.000000',2,'0001-01-01 00:00:00.000000',0),(3,'Перлини Європи: 5 країн','Автобусний тур: Відень, Прага, Будапешт, Краків, Варшава. Екскурсії, гід, проживання 3*.',18900.00,12,'2025-04-15 00:00:00.000000','2025-11-30 00:00:00.000000',3,'0001-01-01 00:00:00.000000',0),(4,'Єгипет: Шарм-ель-Шейх','Кораловий риф, нескінченне сонце та гостинність Єгипту. Включно з перельотом та трансфером.',22000.00,9,'2025-01-01 00:00:00.000000','2025-12-31 00:00:00.000000',1,'0001-01-01 00:00:00.000000',0),(5,'Таїланд: Острів Пхукет','Тропічні пляжі, тайський масаж, екскурсії до храмів та джунглів.',35000.00,14,'2025-10-01 00:00:00.000000','2026-04-30 00:00:00.000000',1,'0001-01-01 00:00:00.000000',0),(6,'Альпійський лижний курорт','Австрійські Альпи, засніжені схили, ски-пас на 7 днів, проживання поряд із підйомником.',31500.00,8,'2025-12-01 00:00:00.000000','2026-03-31 00:00:00.000000',10,'0001-01-01 00:00:00.000000',0),(7,'Сафарі у Кенії','Великі рівнини Масаї Мара, спостереження за «Великою пятіркою», проживання у тентових кемпах.',65000.00,10,'2025-07-01 00:00:00.000000','2025-10-31 00:00:00.000000',11,'0001-01-01 00:00:00.000000',0),(8,'Мальдіви: Blue Lagoon Resort','Бунгало над водою, приватний пляж, снорклінг та дайвінг у кришталево чистій воді.',89000.00,11,'2025-01-01 00:00:00.000000','2025-12-31 00:00:00.000000',9,'0001-01-01 00:00:00.000000',0),(9,'Спа-відпочинок у Карлових Варах','Лікувальні джерела, оздоровчі процедури, прогулянки мальовничим чеським містечком.',14500.00,7,'2025-03-01 00:00:00.000000','2025-11-30 00:00:00.000000',7,'0001-01-01 00:00:00.000000',0),(10,'Круїз Середземномор\'ям','MSC Splendida: Барселона – Марсель – Генуя – Неаполь – Рим. Внутрішня каюта, повний пансіон.',42000.00,9,'2025-04-01 00:00:00.000000','2025-10-31 00:00:00.000000',6,'0001-01-01 00:00:00.000000',0),(11,'Ізраїль: Святі місця','Єрусалим, Віфлеєм, Назарет, Мертве море. Духовна подорож з православним гідом.',25000.00,8,'2025-03-15 00:00:00.000000','2025-05-31 00:00:00.000000',13,'0001-01-01 00:00:00.000000',0),(12,'Гастрономічна Італія','Тоскана, трюфелі, виноробні, кулінарні майстер-класи та дегустаційні вечері в автентичних ресторанах.',27500.00,8,'2025-09-01 00:00:00.000000','2025-11-15 00:00:00.000000',8,'0001-01-01 00:00:00.000000',0),(13,'Сімейний Disney Paris','Діснейленд Париж, екскурсія до центру Парижа, проживання у Disney Hotel. Дітям — анімація цілодобово.',38000.00,6,'2025-06-01 00:00:00.000000','2025-08-31 00:00:00.000000',14,'0001-01-01 00:00:00.000000',0),(14,'Балі: Острів богів','Рисові тераси Убуду, храм Тананлот, серфінг у Куті, традиційний балійський масаж.',41000.00,12,'2025-10-01 00:00:00.000000','2026-03-31 00:00:00.000000',4,'0001-01-01 00:00:00.000000',0),(15,'Норвегія: Фіорди та Полярне сяйво','Бергенська залізниця, круїз фіордами, спостереження за північним сяйвом. Проживання 4*.',55000.00,9,'2025-11-01 00:00:00.000000','2026-02-28 00:00:00.000000',5,'0001-01-01 00:00:00.000000',0),(16,'Грузія: Душа Кавказу','Тбілісі, Мцхета, Казбегі, Батумі. Дегустація вин Кахетії, монастирі та кавказька кухня.',9800.00,7,'2025-04-01 00:00:00.000000','2025-11-30 00:00:00.000000',3,'0001-01-01 00:00:00.000000',0),(17,'Бангкок – Паттайя','Мегаполіс і море: храм Ват Пхо, тайська кухня на вуличних ринках, пляжний відпочинок у Паттаї.',32000.00,11,'2025-10-15 00:00:00.000000','2026-04-15 00:00:00.000000',8,'0001-01-01 00:00:00.000000',0),(18,'Дубай: Місто майбутнього','Бурдж-Халіфа, сафарі в пустелі, шопінг у Dubai Mall, аквапарк Atlantis. Готель 5*.',47500.00,8,'2025-10-01 00:00:00.000000','2026-04-30 00:00:00.000000',3,'0001-01-01 00:00:00.000000',0),(22,'Тестовий тур','Тур для перевірки CatalogService',1500.00,7,'2026-10-01 00:00:00.000000','2026-12-31 00:00:00.000000',1,'0001-01-01 00:00:00.000000',0),(24,'PUT Test Tour Updated','Оновлений тест PUT',5000.00,365,'2026-10-09 09:45:57.513000','2028-10-09 09:45:57.513000',1,'0001-01-01 00:00:00.000000',1),(27,'Soft Delete Test Tour','Тест перевірки м\'якого видалення',4500.00,5,'2026-10-10 00:00:00.000000','2028-10-20 00:00:00.000000',1,'2026-10-01 16:36:21.591085',1),(28,'string','string',10000.00,365,'2026-10-09 09:37:38.366000','2026-10-09 09:37:38.366000',2,'2026-10-09 09:39:40.641237',1),(29,'TESTING','string',50000.00,365,'2026-10-30 15:39:18.329000','2027-10-30 15:39:18.329000',2,'2026-10-30 15:40:17.582794',1),(30,'TESTING2','string',50000.00,365,'2026-10-30 15:39:18.329000','2027-10-30 15:39:18.329000',2,'2026-10-30 15:40:40.052666',1);
